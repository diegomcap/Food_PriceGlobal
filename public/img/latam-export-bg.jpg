<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a2a6c;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#b21f1f;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fdbb2d;stop-opacity:1" />
    </linearGradient>
    <pattern id="pattern1" width="60" height="60" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="30" height="30" fill="rgba(255, 255, 255, 0.03)" />
    </pattern>
    <mask id="mask1">
      <rect width="1920" height="1080" fill="white" />
      <g transform="translate(960, 540)">
        <path d="M-400,-300 Q-200,-400 0,-300 T400,-300 T800,-300 T1200,-300 V300 Q1000,400 800,300 T400,300 T0,300 T-400,300 T-800,300 V-300 Q-600,-400 -400,-300 Z" fill="black" />
      </g>
    </mask>
  </defs>
  
  <!-- Background gradient -->
  <rect width="1920" height="1080" fill="url(#grad1)" />
  
  <!-- Pattern overlay -->
  <rect width="1920" height="1080" fill="url(#pattern1)" />
  
  <!-- South America silhouette (simplified) -->
  <g transform="translate(960, 540) scale(0.8)" opacity="0.15" fill="white">
    <path d="M-100,-200 Q0,-250 100,-200 T300,-150 T400,-50 T450,50 T400,150 T300,250 T150,300 T0,250 T-100,150 T-150,50 T-100,-50 T-100,-200 Z" />
  </g>
  
  <!-- Dots representing countries -->
  <g fill="white" opacity="0.6">
    <circle cx="860" cy="480" r="8" />
    <circle cx="900" cy="600" r="6" />
    <circle cx="820" cy="550" r="7" />
    <circle cx="950" cy="450" r="5" />
    <circle cx="780" cy="500" r="6" />
    <circle cx="1000" cy="520" r="7" />
    <circle cx="880" cy="420" r="5" />
  </g>
  
  <!-- Connection lines -->
  <g stroke="white" stroke-width="1" opacity="0.2">
    <line x1="860" y1="480" x2="900" y2="600" />
    <line x1="860" y1="480" x2="820" y2="550" />
    <line x1="860" y1="480" x2="950" y2="450" />
    <line x1="900" y1="600" x2="780" y2="500" />
    <line x1="820" y1="550" x2="1000" y2="520" />
    <line x1="950" y1="450" x2="880" y2="420" />
  </g>
  
  <!-- Overlay with pattern -->
  <rect width="1920" height="1080" fill="url(#pattern1)" opacity="0.3" />
</svg>